# 强制 LF：Windows 上开发、Linux 容器里执行，CRLF 会让
# `bash run.sh` 报 "No such file or directory"（因为 shebang 变成了 /usr/bin/env bash\r）
* text=auto eol=lf

*.sh           text eol=lf
*.bash         text eol=lf
Dockerfile     text eol=lf
*.yml          text eol=lf
*.yaml         text eol=lf
*.env          text eol=lf
Makefile       text eol=lf
*.md           text eol=lf
*.go           text eol=lf
*.rs           text eol=lf
*.c            text eol=lf
*.h            text eol=lf
*.cpp          text eol=lf
*.hpp          text eol=lf
*.cc           text eol=lf
*.py           text eol=lf
*.java         text eol=lf

# 二进制
*.png  binary
*.jpg  binary
*.gz   binary
