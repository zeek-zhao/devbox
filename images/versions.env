# devbox 版本单一真本
# ------------------------------------------------------------------
# 规则：所有镜像里的版本号只能来自这个文件，Dockerfile 里禁止写死版本。
# 改这里 -> push -> CI 自动重算受影响层。CI 会把本文件内容打成 artifact 存档。
# ------------------------------------------------------------------

# ---- 底座 ----
UBUNTU_TAG=24.04
APT_MIRROR=mirrors.ustc.edu.cn

# ---- C / C++ ----
GCC_MAJOR=14
CLANG_MAJOR=18
CMAKE_MIN_VERSION=3.28
# clang-format 必须与 CLANG_MAJOR 同步：格式化规则随 LLVM 版本变，
# 版本不一致会让「本地 fmt 通过、CI fmt-check 报差异」。
CLANG_FORMAT_MAJOR=18

# ---- 格式化工具 ----
# 这三个版本一变，全仓库代码的排版就可能变。改之前先想清楚：
# 一旦改了，下一次 make fmt-check 会在所有语言上报差异。
GJF_VERSION=1.22.0
GJF_SHA256=16b2a1ee938686c8b1d88abf19eb83dfd0d623cee9de6fc6d09980214f816d3f
YQ_VERSION=4.44.3
# 只锁了 amd64 的校验和（CI runner 与 215 都是 x86_64）；
# 换 arm64 时必须补上对应校验和，install/shell.sh 会直接报错而不是静默跳过。
YQ_SHA256=a2c097180dd884a8d50c956ee16a9cec070f30a7947cf4ebf87d5f36213e9ed7

# ---- Go ----
GO_VERSION=1.27.3
GO_SHA256=65efbc80fdc1fa2cd2631cad5b481777a68e8725f34e89f50fc6ac714e379b40
GOPROXY=https://goproxy.cn,direct
GOSUMDB=sum.golang.google.cn

# ---- Rust ----
RUST_TOOLCHAIN=stable
RUSTUP_DIST_SERVER=https://mirrors.ustc.edu.cn/rust-static
RUSTUP_UPDATE_ROOT=https://mirrors.ustc.edu.cn/rust-static/rustup

# ---- Python ----
PYTHON_VERSION=3.12
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# ---- Java ----
JAVA_MAJOR=21
# Gradle 走 apt（24.04 是 4.4，太旧），Java 项目统一用 Maven + Spring Boot
MAVEN_OPTS=-Dmaven.repo.local=/opt/m2 -Dfile.encoding=UTF-8

# ---- Shell ----
SHELLCHECK_SEVERITY=warning

# ---- 镜像发布 ----
REGISTRY=ghcr.io/zeek-zhao
