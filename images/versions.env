# devbox 版本单一真本
# ------------------------------------------------------------------
# 规则：所有镜像里的版本号只能来自这个文件，Dockerfile 里禁止写死版本。
# 改这里 -> push -> CI 自动重算受影响层。CI 会把本文件内容打成 artifact 存档。
# ------------------------------------------------------------------

# ---- 底座 ----
UBUNTU_TAG=24.04
APT_MIRROR=mirrors.ustc.edu.cn

# ---- C / C++ ----
GCC_MAJOR=14
CLANG_MAJOR=18
CMAKE_MIN_VERSION=3.28

# ---- Go ----
GO_VERSION=1.27.3
GO_SHA256=65efbc80fdc1fa2cd2631cad5b481777a68e8725f34e89f50fc6ac714e379b40
GOPROXY=https://goproxy.cn,direct
GOSUMDB=sum.golang.google.cn

# ---- Rust ----
RUST_TOOLCHAIN=stable
RUSTUP_DIST_SERVER=https://mirrors.ustc.edu.cn/rust-static
RUSTUP_UPDATE_ROOT=https://mirrors.ustc.edu.cn/rust-static/rustup

# ---- Python ----
PYTHON_VERSION=3.12
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# ---- Java ----
JAVA_MAJOR=21
# Gradle 走 apt（24.04 是 4.4，太旧），Java 项目统一用 Maven + Spring Boot
MAVEN_OPTS=-Dmaven.repo.local=/opt/m2 -Dfile.encoding=UTF-8

# ---- Shell ----
SHELLCHECK_SEVERITY=warning

# ---- 镜像发布 ----
REGISTRY=ghcr.io/zeek-zhao
